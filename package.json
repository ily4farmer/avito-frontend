{
  "version": "1.0.0",
  "description": "My webpack project",
  "name": "webpack-project",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "webpack --mode=production --config-node-env=production",
    "build:client": "webpack --mode production --env target=client",
    "build:server:dev": "webpack --mode development --env target=server",
    "build:server": "webpack --mode production --env target=server",
    "build:ssr": "pnpm build:client && pnpm build:server",
    "start:ssr": "node dist/server/server.cjs",
    "dev": "webpack serve --mode development",
    "serve": "webpack serve",
    "watch": "webpack --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@swc/core": "^1.16.21",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router": "^5.1.20",
    "compression-webpack-plugin": "^12.0.0",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mini-css-extract-plugin": "^2.10.2",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "workbox-webpack-plugin": "^7.4.1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.1",
    "axios": "^1.21.0",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.16"
  }
}
