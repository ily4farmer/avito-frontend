{
  "version": "0.1.0",
  "description": "React SSR boilerplate with Webpack and Express",
  "name": "react-ssr-boilerplate",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "webpack --mode production --env target=client",
    "build:server": "webpack --mode production --env target=server",
    "build:ssr": "pnpm build",
    "start": "node dist/server/server.cjs",
    "start:ssr": "pnpm start",
    "dev": "rimraf dist/client-dev dist/server-dev && concurrently -k -n client,server,express \"pnpm dev:client\" \"pnpm dev:server\" \"pnpm dev:express\"",
    "dev:client": "webpack --mode development --env target=client --watch",
    "dev:server": "webpack --mode development --env target=server --watch",
    "dev:express": "wait-on dist/client-dev/manifest.json dist/server-dev/server.cjs && node --watch dist/server-dev/server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/ssr.test.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@swc/core": "^1.16.21",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "css-loader": "^7.1.5",
    "husky": "^9.1.7",
    "mini-css-extract-plugin": "^2.10.2",
    "rimraf": "^6.1.4",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wait-on": "^9.5.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.1",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.16"
  }
}
